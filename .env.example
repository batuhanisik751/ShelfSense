# Local development values go here (copy to .env).
# In production these are set in Vercel → Project Settings → Environment Variables,
# Production scope only (Preview and Development are intentionally blocked —
# see vercel.json `git.deploymentEnabled` and the project's ignored build step).

# Canonical site origin — used to build magic-link `emailRedirectTo` URLs.
# REQUIRED in production to prevent host-header injection. Must also be added to the
# Supabase Auth redirect allow-list (dashboard → Authentication → URL Configuration).
# In local dev this is optional; if unset, the origin falls back to the request Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Groq — https://console.groq.com/keys
# Server-only. Used by /api routes for llama-3.1-8b-instant calls.
GROQ_API_KEY=

# ─── Dev-only convenience ────────────────────────────────────────────────
# Local auth bypass. When set to `1`, middleware skips the magic-link gate
# and /api/dev/session auto-creates + signs in a fixed dev user
# (`dev@shelfsense.local`) on every first request, so you never have to
# click a magic link while iterating on /pantry, /receipts, etc.
#
# Force-disabled in production: `isAuthBypassed()` in src/lib/auth/bypass.ts
# returns false whenever NODE_ENV === 'production', so setting this on
# Vercel has no effect — but leave it unset there anyway for clarity.
#
# Requires SUPABASE_SERVICE_ROLE_KEY to be set (above), since the auto-login
# route uses the admin API to create/confirm the dev user.
AUTH_BYPASS=
